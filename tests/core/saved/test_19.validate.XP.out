<dense-test>
  <a-flat>
    <a-disk>
      <name>sda</name>
      <size>100</size>
      <note>ok</note>
      <tag>x</tag>
      <tag>y</tag>
    </a-disk>
    <a-disk>
      <name>sdb</name>
      <size>200</size>
      <note>true</note>
      <tag>x</tag>
      <tag>y</tag>
    </a-disk>
    <a-disk>
      <name>sdc</name>
      <size>300</size>
      <note>ok</note>
      <tag>x</tag>
      <tag>z,w</tag>
    </a-disk>
  </a-flat>
  <b-nested-container>
    <b-route>
      <dest>10.0.0.0/24</dest>
      <proto>static</proto>
      <via>
        <interface>eth0</interface>
        <gateway>10.0.0.1</gateway>
      </via>
    </b-route>
    <b-route>
      <dest>10.0.1.0/24</dest>
      <proto>direct</proto>
      <via>
        <interface>eth1</interface>
        <gateway>10.0.1.1</gateway>
      </via>
    </b-route>
  </b-nested-container>
  <f-late-nested>
    <f-user>
      <name>root</name>
      <uid>0</uid>
    </f-user>
    <f-user>
      <name>phil</name>
      <uid>1001</uid>
      <f-group>
        <gname>wheel</gname>
      </f-group>
    </f-user>
  </f-late-nested>
  <c-nested-list>
    <c-host>
      <host>alpha</host>
      <state>up</state>
      <c-port>
        <port>20</port>
        <proto>tcp</proto>
      </c-port>
      <c-port>
        <port>21</port>
        <proto>udp</proto>
        <c-conn>
          <peer>10.9.9.9</peer>
        </c-conn>
      </c-port>
    </c-host>
    <c-host>
      <host>beta</host>
      <state>down</state>
      <c-port>
        <port>120</port>
        <proto>tcp</proto>
      </c-port>
      <c-port>
        <port>121</port>
        <proto>udp</proto>
      </c-port>
    </c-host>
    <c-host>
      <host>gamma</host>
      <state>up</state>
      <c-port>
        <port>220</port>
        <proto>tcp</proto>
      </c-port>
      <c-port>
        <port>221</port>
        <proto>udp</proto>
      </c-port>
    </c-host>
  </c-nested-list>
  <d-modifier>
    <d-cpu>
      <num>0</num>
      <load>0</load>
    </d-cpu>
    <d-cpu>
      <num>1</num>
      <load>7</load>
    </d-cpu>
    <d-cpu>
      <num>2</num>
      <load>14</load>
    </d-cpu>
  </d-modifier>
  <e-xof-dense>
    <e-item>
      <sku>A1</sku>
      <qty>2</qty>
    </e-item>
    <e-item>
      <sku>B2</sku>
      <qty>1</qty>
      <e-part>
        <part>bolt</part>
      </e-part>
    </e-item>
  </e-xof-dense>
  <g-empty-first>
    <g-entry>
    </g-entry>
    <g-entry>
      <name>second</name>
    </g-entry>
  </g-empty-first>
</dense-test>
