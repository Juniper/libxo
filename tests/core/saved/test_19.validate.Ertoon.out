@version 1.0.0
dense-test
  a-flat
    a-disk
      - name=sda
        size 100
        note ok
        tag x,y,
      - name=sdb
        size 200
        note "true"
        tag x,y,
      - name=sdc
        size 300
        note ok
        tag x,"z,w",
  b-nested-container
    b-route
      - dest=10.0.0.0/24
        proto static
        via
          interface eth0
          gateway 10.0.0.1
      - dest=10.0.1.0/24
        proto direct
        via
          interface eth1
          gateway 10.0.1.1
  f-late-nested
    f-user
      - name=root
        uid 0
      - name=phil
        uid 1001
        f-group
          - gname=wheel
  c-nested-list
    c-host
      - host=alpha
        state up
        c-port
          - port=20
            proto tcp
          - port=21
            proto udp
            c-conn
              - peer=10.9.9.9
      - host=beta
        state down
        c-port
          - port=120
            proto tcp
          - port=121
            proto udp
      - host=gamma
        state up
        c-port
          - port=220
            proto tcp
          - port=221
            proto udp
  d-modifier
    d-cpu
      {num=,load}
      0,0
      1,7
      2,14
  e-xof-dense
    e-item
      {sku=,qty}
      A1,2
      B2,1
  g-empty-first
    g-entry
      - ""
      - name=second
