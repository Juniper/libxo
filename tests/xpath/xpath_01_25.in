#
# Integer math stays in int64/uint64 while results fit; floats
# (which lose precision past 2^53) are the last resort
#

# Test 1: uint64 add (equal in floats) (expect: one, two)
?num[big + 1 != big]
{num
<num
= id one
= big 18446744073709551614
= max 9223372036854775807
= neg -9223372036854775808
= hex 0x10
= octal 010
= half 2.5
>num
<num
= id two
= big 2
= max 1
= neg -1
= hex 0x1
= octal 07
= half 0.5
>num
}num

# Test 2: int64 subtract (equal in floats) (expect: one, two)
r
?num[max - 1 != max]
{num
<num
= id one
= big 18446744073709551614
= max 9223372036854775807
= neg -9223372036854775808
= hex 0x10
= octal 010
= half 2.5
>num
<num
= id two
= big 2
= max 1
= neg -1
= hex 0x1
= octal 07
= half 0.5
>num
}num

