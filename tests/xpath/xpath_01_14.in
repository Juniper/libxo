# concat two key fields: only items where first+last = 'JohnDoe' pass
r
?item[concat(first, last) = 'JohnDoe']
{item
<item
$ first John
$ last Doe
= val 1
>item
<item
$ first Jane
$ last Doe
= val 2
>item
<item
$ first John
$ last Smith
= val 3
>item
}item

# concat with a literal separator
r
?item[concat(host, ':', port) = 'db:5432']
{item
<item
$ host db
$ port 5432
= val 1
>item
<item
$ host db
$ port 3306
= val 2
>item
<item
$ host web
$ port 5432
= val 3
>item
}item

# concat three arguments
r
?item[concat(a, b, c) = 'xyz']
{item
<item
$ a x
$ b y
$ c z
= val 1
>item
<item
$ a x
$ b y
$ c w
= val 2
>item
<item
$ a x
$ b b
$ c z
= val 3
>item
}item

# concat result used in starts-with
r
?item[starts-with(concat(proto, '://'), 'http://')]
{item
<item
$ proto http
= val 1
>item
<item
$ proto ftp
= val 2
>item
<item
$ proto http
= val 3
>item
}item

# '_' operator: two-arg concat, no parens needed (binds tighter than '=')
r
?item[first _ last = 'JohnDoe']
{item
<item
$ first John
$ last Doe
= val 1
>item
<item
$ first Jane
$ last Doe
= val 2
>item
<item
$ first John
$ last Smith
= val 3
>item
}item

# '_' three-arg with literal: exercises the flat-list extension in concat_rewrite
r
?item[host _ ':' _ port = 'db:5432']
{item
<item
$ host db
$ port 5432
= val 1
>item
<item
$ host db
$ port 3306
= val 2
>item
<item
$ host web
$ port 5432
= val 3
>item
}item

# '_' four-arg chain: two successive flat extensions (a_b_c_d -> concat(a,b,c,d))
r
?item[a _ b _ c _ d = 'wxyz']
{item
<item
$ a w
$ b x
$ c y
$ d z
= val 1
>item
<item
$ a w
$ b x
$ c y
$ d q
= val 2
>item
<item
$ a w
$ b X
$ c y
$ d z
= val 3
>item
}item

# a cast to a string keeps every digit of a wide integer
r
?item[concat(1234567890123456789, '') = '1234567890123456789']
{item
<item
$ name wide
= val 1
>item
}item

# a cast to a string keeps every digit of a wide float
r
?item[concat(12345678901234.5, 'x') = '12345678901234.500000x']
{item
<item
$ name float
= val 2
>item
}item

# unary minus negates a number, and an integer stays an integer
r
?item[concat(-5, '') = '-5']
{item
<item
$ name negative
= val 3
>item
}item

# unary minus on a field, twice over, and next to a subtraction
r
?item[-val = -4 and - -val = 4 and 1 - -val = 5]
{item
<item
$ name three
= val 3
>item
<item
$ name four
= val 4
>item
}item
