#
# NaN: missing fields and non-numeric strings are NaN (C_NAN),
# which is unordered: every comparison with it is false, except !=
#

# Test 1: missing field in arithmetic (expect: none)
?item[missing + 1 = 1]
{item
<item
= name widget
= a 42
= b 144
= count 3
>item
<item
= name gadget
= a 70
= b 8
= count lots
>item
}item

# Test 2: NaN != anything (expect: both)
r
?item[missing + 1 != 1]
{item
<item
= name widget
= a 42
= b 144
= count 3
>item
<item
= name gadget
= a 70
= b 8
= count lots
>item
}item

# Test 3: NaN is not less (expect: none)
r
?item[missing < 1]
{item
<item
= name widget
= a 42
= b 144
= count 3
>item
<item
= name gadget
= a 70
= b 8
= count lots
>item
}item

# Test 4: NaN is not greater or equal (expect: none)
r
?item[missing >= 1]
{item
<item
= name widget
= a 42
= b 144
= count 3
>item
<item
= name gadget
= a 70
= b 8
= count lots
>item
}item

# Test 5: not() of a NaN comparison (expect: both)
r
?item[not(missing + 1 = 1)]
{item
<item
= name widget
= a 42
= b 144
= count 3
>item
<item
= name gadget
= a 70
= b 8
= count lots
>item
}item

# Test 6: non-numeric string vs number (expect: none)
r
