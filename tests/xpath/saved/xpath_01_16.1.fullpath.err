main: input '#run --libxo @fullpath'
main: input ''
main: input '# choose2(a, b): if a is truthy return a's own value, else return b.'
main: input '# Missing first key falls through to the second (fallback) key.'
main: input '# Keys with an override are listed first so the filter resolves on override.'
main: input 'r'
main: status: zero
main: input '?item[choose2(override, base-id) = '42']'
