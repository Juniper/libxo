# true() always passes every instance
r
?item[true()]
{item
<item
$ id 1
= val alpha
>item
<item
$ id 2
= val beta
>item
<item
$ id 3
= val gamma
>item
}item

# false() never passes any instance
r
?item[false()]
{item
<item
$ id 1
= val alpha
>item
<item
$ id 2
= val beta
>item
<item
$ id 3
= val gamma
>item
}item

# not() inverts a key equality predicate
r
?item[not(color='red')]
{item
<item
$ color red
= val 1
>item
<item
$ color blue
= val 2
>item
<item
$ color red
= val 3
>item
<item
$ color green
= val 4
>item
}item

# not(true()) is always false
r
?item[not(true())]
{item
<item
$ id 1
= val alpha
>item
<item
$ id 2
= val beta
>item
}item

# not(false()) is always true
r
?item[not(false())]
{item
<item
$ id 1
= val alpha
>item
<item
$ id 2
= val beta
>item
}item

# not(not(x)) == x: double negation is identity
r
?item[not(not(color='red'))]
{item
<item
$ color red
= val 1
>item
<item
$ color blue
= val 2
>item
<item
$ color red
= val 3
>item
}item

# boolean(1) is true; boolean(0) is false
r
?item[boolean(1)]
{item
<item
$ id 1
= val alpha
>item
<item
$ id 2
= val beta
>item
}item

r
?item[boolean(0)]
{item
<item
$ id 1
= val alpha
>item
<item
$ id 2
= val beta
>item
}item

# boolean() of a comparison is the same as the comparison itself
r
?item[boolean(color='red')]
{item
<item
$ color red
= val 1
>item
<item
$ color blue
= val 2
>item
<item
$ color red
= val 3
>item
}item

# ceiling() rounds fractional values up
r
?item[ceiling(price) > 3]
{item
<item
$ price 1.2
= val a
>item
<item
$ price 3.1
= val b
>item
<item
$ price 3.9
= val c
>item
<item
$ price 2.7
= val d
>item
}item

# floor() rounds fractional values down
r
?item[floor(price) >= 3]
{item
<item
$ price 2.9
= val a
>item
<item
$ price 3.0
= val b
>item
<item
$ price 3.7
= val c
>item
<item
$ price 4.1
= val d
>item
}item

# ceiling(x) == floor(x) only when x is an integer
r
?item[ceiling(price) == floor(price)]
{item
<item
$ price 2.0
= val a
>item
<item
$ price 2.5
= val b
>item
<item
$ price 3.0
= val c
>item
<item
$ price 3.9
= val d
>item
}item

# number() converts string key to numeric value; non-numeric strings become 0
r
?item[number(price) == 2]
{item
<item
$ price 2.0
= val a
>item
<item
$ price 2gether
= val b
>item
<item
$ price 3
= val c
>item
<item
$ price 2.0.4.5
= val d
>item
}item

# contains(haystack, needle) is true when haystack contains needle as a substring
r
?item[contains(label, 'eth')]
{item
<item
$ label eth0
= val 1
>item
<item
$ label lo0
= val 2
>item
<item
$ label eth1
= val 3
>item
<item
$ label wlan0
= val 4
>item
}item

# contains with value from the middle of the string
r
?item[contains(name, 'oo')]
{item
<item
$ name foo
= val 1
>item
<item
$ name bar
= val 2
>item
<item
$ name foobar
= val 3
>item
<item
$ name boo
= val 4
>item
}item

# contains combined with not()
r
?item[not(contains(label, 'eth'))]
{item
<item
$ label eth0
= val 1
>item
<item
$ label lo0
= val 2
>item
<item
$ label eth1
= val 3
>item
<item
$ label wlan0
= val 4
>item
}item

# substring(str, pos, len) returns a partial string
r
?item[substring(iface, 2, 3) = 'th0']
{item
<item
$ iface eth0.0
= val 1
>item
<item
$ iface eth1.0
= val 2
>item
<item
$ iface eth0.1
= val 3
>item
<item
$ iface lo0
= val 4
>item
}item

# substring again
r
?item[substring(name, 5) = 'c']
{item
<item
$ name pkg-a
= val 1
>item
<item
$ name pkg-b
= val 2
>item
<item
$ name lib-c
= val 3
>item
<item
$ name nohyphen
= val 4
>item
}item

# substring-before(str, needle) returns the part before the first needle
r
?item[substring-before(iface, '.') = 'eth0']
{item
<item
$ iface eth0.0
= val 1
>item
<item
$ iface eth1.0
= val 2
>item
<item
$ iface eth0.1
= val 3
>item
<item
$ iface lo0
= val 4
>item
}item

# substring-before returns '' when needle is absent (no match)
r
?item[substring-before(name, '-') = 'pkg']
{item
<item
$ name pkg-a
= val 1
>item
<item
$ name pkg-b
= val 2
>item
<item
$ name lib-c
= val 3
>item
<item
$ name nohyphen
= val 4
>item
}item

# substring-after(str, needle) returns the part after the first needle
r
?item[substring-after(version, '-') = '2']
{item
<item
$ version pkg-1
= val 1
>item
<item
$ version pkg-2
= val 2
>item
<item
$ version lib-2
= val 3
>item
<item
$ version nohyphen
= val 4
>item
}item

# substring-after returns '' when needle absent (no match)
r
?item[substring-after(path, '/') = 'usr']
{item
<item
$ path /usr
= val 1
>item
<item
$ path /etc
= val 2
>item
<item
$ path noslash
= val 3
>item
}item

# composition: starts-with(substring-after(name, '.'), 'e')
r
?item[starts-with(substring-after(name, '.'), 'e')]
{item
<item
$ name lo.eth0
= val 1
>item
<item
$ name lo.lo0
= val 2
>item
<item
$ name lo.eth1
= val 3
>item
<item
$ name nodot
= val 4
>item
}item

# a field is true if it exists, even when its value is 0: all items pass
r
?item[boolean(name)]
{item
<item
$ name alpha
$ rate 0.5
= val 1
>item
<item
$ name 0
$ rate 0
= val 2
>item
<item
$ name 12
$ rate 0.0
= val 3
>item
}item

# and its not() is false: no items pass
r
?item[not(name)]
{item
<item
$ name alpha
$ rate 0.5
= val 1
>item
<item
$ name 0
$ rate 0
= val 2
>item
<item
$ name 12
$ rate 0.0
= val 3
>item
}item

# a field that is not there is false: all items pass
r
?item[not(missing)]
{item
<item
$ name alpha
$ rate 0.5
= val 1
>item
<item
$ name 0
$ rate 0
= val 2
>item
<item
$ name 12
$ rate 0.0
= val 3
>item
}item

# to test a value, make it a number; a float is not truncated,
# so 0.5 is true: only item 1 passes
r
?item[boolean(number(rate))]
{item
<item
$ name alpha
$ rate 0.5
= val 1
>item
<item
$ name 0
$ rate 0
= val 2
>item
<item
$ name 12
$ rate 0.0
= val 3
>item
}item

# a float literal less than one is true: all items pass
r
?item[boolean(0.5)]
{item
<item
$ name alpha
$ rate 0.5
= val 1
>item
<item
$ name 0
$ rate 0
= val 2
>item
<item
$ name 12
$ rate 0.0
= val 3
>item
}item

# 'and' casts both sides the same way: only item 1 passes
r
?item[name and number(rate)]
{item
<item
$ name alpha
$ rate 0.5
= val 1
>item
<item
$ name 0
$ rate 0
= val 2
>item
<item
$ name 12
$ rate 0.0
= val 3
>item
}item

# a string literal is true unless empty, even '0': all items pass
r
?item[boolean('0')]
{item
<item
$ name alpha
$ rate 0.5
= val 1
>item
<item
$ name 0
$ rate 0
= val 2
>item
<item
$ name 12
$ rate 0.0
= val 3
>item
}item

# the empty string is false: no items pass
r
?item[boolean('')]
{item
<item
$ name alpha
$ rate 0.5
= val 1
>item
<item
$ name 0
$ rate 0
= val 2
>item
<item
$ name 12
$ rate 0.0
= val 3
>item
}item

# isempty(): an empty field is empty, and so is an absent one (an
# empty nodeset); "0" is not empty.  Items 2 and 3 pass.
r
?item[isempty(name)]
{item
<item
$ name alpha
= note hello
= val 1
>item
<item
$ name ""
= note ""
= val 2
>item
<item
= val 3
>item
<item
$ name 0
= note 0
= val 4
>item
}item

# The same, with a non-key field: items 2 and 3 pass.
r
?item[isempty(note)]
{item
<item
$ name alpha
= note hello
= val 1
>item
<item
$ name ""
= note ""
= val 2
>item
<item
= val 3
>item
<item
$ name 0
= note 0
= val 4
>item
}item

# !isempty() asks for content: items 1 and 4 pass.
r
?item[!isempty(name)]
{item
<item
$ name alpha
= note hello
= val 1
>item
<item
$ name ""
= note ""
= val 2
>item
<item
= val 3
>item
<item
$ name 0
= note 0
= val 4
>item
}item

# A field is true when it exists, even when empty: items 1, 2 and 4.
r
?item[name]
{item
<item
$ name alpha
= note hello
= val 1
>item
<item
$ name ""
= note ""
= val 2
>item
<item
= val 3
>item
<item
$ name 0
= note 0
= val 4
>item
}item

# As a string, the empty field is false: items 1 and 4 pass.
r
?item[string(name)]
{item
<item
$ name alpha
= note hello
= val 1
>item
<item
$ name ""
= note ""
= val 2
>item
<item
= val 3
>item
<item
$ name 0
= note 0
= val 4
>item
}item

# An empty literal is empty, so all items pass.
r
?item[isempty('')]
{item
<item
$ name alpha
= note hello
= val 1
>item
<item
$ name ""
= note ""
= val 2
>item
<item
= val 3
>item
<item
$ name 0
= note 0
= val 4
>item
}item
