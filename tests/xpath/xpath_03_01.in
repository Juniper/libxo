<inventory site="lab">
<item id="i1" kind="cpu"><name>alpha</name><size>10</size><tag>a</tag><tag>b</tag></item>
<item id="i2" kind="mem"><name>beta</name><size>20</size><tag>b</tag></item>
<item id="i3" kind="cpu"><name>gamma</name><size>5</size><sub><name>delta</name><size>7</size></sub></item>
<group><item id="i4" kind="disk"><name>epsilon</name><size>20</size></item></group>
</inventory>
%%
