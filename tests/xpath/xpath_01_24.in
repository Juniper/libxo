# Test 1: existence of a non-key child: only the items with a sku
?top/item[sku]
+ top
{ item
< item
$ name gum
= sku GRO-000-415
= sold 1412
> item
< item
$ name rope
= sold 85
> item
< item
$ name ladder
= sku HRD-000-212
= sold 0
> item
< item
$ name bubblegum
= sold 17
> item
} item
- top

# Test 2: existence of the key: every item
r
?top/item[name]
+ top
{ item
< item
$ name gum
= sku GRO-000-415
= sold 1412
> item
< item
$ name rope
= sold 85
> item
< item
$ name ladder
= sku HRD-000-212
= sold 0
> item
< item
$ name bubblegum
= sold 17
> item
} item
- top

# Test 3: existence of a child no item has: nothing
r
?top/item[color]
+ top
{ item
< item
$ name gum
= sku GRO-000-415
= sold 1412
> item
< item
$ name rope
= sold 85
> item
< item
