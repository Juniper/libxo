# Test 4: a string against a boolean uses the string's truth, not 'equal'
r
?top/item[name = true()]
+ top
{ item
< item
$ name gum
= sku GRO-000-415
= sold 1412
> item
< item
$ name rope
= sold 85
> item
< item
$ name ladder
= sku HRD-000-212
= sold 0
> item
< item
$ name bubblegum
= sold 17
> item
} item
- top

# Test 5: the same compare against false(): nothing
r
?top/item[name = false()]
