# 0 - ENOERROR
msgid "No error: 0"
msgstr "Sin error: 0"

# 1 - EPERM
msgid "Operation not permitted"
msgstr "Operación no permitida"

# 2 - ENOENT
msgid "No such file or directory"
msgstr "No existe el archivo o el directorio"

# 3 - ESRCH
msgid "No such process"
msgstr "No existe el proceso"

# 4 - EINTR
msgid "Interrupted system call"
msgstr "Llamada al sistema interrumpida"

# 5 - EIO
msgid "Input/output error"
msgstr "Error de entrada/salida"

# 6 - ENXIO
msgid "Device not configured"
msgstr "Dispositivo no configurado"

# 7 - E2BIG
msgid "Argument list too long"
msgstr "Lista de argumentos demasiado larga"

# 8 - ENOEXEC
msgid "Exec format error"
msgstr "Error de formato de ejecutable"

# 9 - EBADF
msgid "Bad file descriptor"
msgstr "Descriptor de archivo incorrecto"

# 10 - ECHILD
msgid "No child processes"
msgstr "No hay procesos hijos"

# 11 - EDEADLK
msgid "Resource deadlock avoided"
msgstr "Se evitó un interbloqueo de recursos"

# 12 - ENOMEM
msgid "Cannot allocate memory"
msgstr "No se puede asignar memoria"

# 13 - EACCES
msgid "Permission denied"
msgstr "Permiso denegado"

# 14 - EFAULT
msgid "Bad address"
msgstr "Dirección incorrecta"

# 15 - ENOTBLK
msgid "Block device required"
msgstr "Se requiere un dispositivo de bloques"

# 16 - EBUSY
msgid "Device busy"
msgstr "Dispositivo ocupado"

# 17 - EEXIST
msgid "File exists"
msgstr "El archivo ya existe"

# 18 - EXDEV
msgid "Cross-device link"
msgstr "Enlace entre dispositivos"

# 19 - ENODEV
msgid "Operation not supported by device"
msgstr "Operación no admitida por el dispositivo"

# 20 - ENOTDIR
msgid "Not a directory"
msgstr "No es un directorio"

# 21 - EISDIR
msgid "Is a directory"
msgstr "Es un directorio"

# 22 - EINVAL
msgid "Invalid argument"
msgstr "Argumento inválido"

# 23 - ENFILE
msgid "Too many open files in system"
msgstr "Demasiados archivos abiertos en el sistema"

# 24 - EMFILE
msgid "Too many open files"
msgstr "Demasiados archivos abiertos"

# 25 - ENOTTY
msgid "Inappropriate ioctl for device"
msgstr "Ioctl inapropiado para el dispositivo"

# 26 - ETXTBSY
msgid "Text file busy"
msgstr "Archivo de texto ocupado"

# 27 - EFBIG
msgid "File too large"
msgstr "Archivo demasiado grande"

# 28 - ENOSPC
msgid "No space left on device"
msgstr "No queda espacio en el dispositivo"

# 29 - ESPIPE
msgid "Illegal seek"
msgstr "Búsqueda ilegal"

# 30 - EROFS
msgid "Read-only file system"
msgstr "Sistema de archivos de solo lectura"

# 31 - EMLINK
msgid "Too many links"
msgstr "Demasiados enlaces"

# 32 - EPIPE
msgid "Broken pipe"
msgstr "Tubería rota"

#
# math software
#
# 33 - EDOM
msgid "Numerical argument out of domain"
msgstr "Argumento numérico fuera del dominio"

# 34 - ERANGE
msgid "Result too large"
msgstr "Resultado demasiado grande"

#
# non-blocking and interrupt i/o
#
# 35 - EAGAIN
# 35 - EWOULDBLOCK
msgid "Resource temporarily unavailable"
msgstr "Recurso no disponible temporalmente"

# 36 - EINPROGRESS
msgid "Operation now in progress"
msgstr "Operación en curso"

# 37 - EALREADY
msgid "Operation already in progress"
msgstr "La operación ya está en curso"

#
# ipc/network software -- argument errors
#
# 38 - ENOTSOCK
msgid "Socket operation on non-socket"
msgstr "Operación de socket en algo que no es un socket"

# 39 - EDESTADDRREQ
msgid "Destination address required"
msgstr "Se requiere una dirección de destino"

# 40 - EMSGSIZE
msgid "Message too long"
msgstr "Mensaje demasiado largo"

# 41 - EPROTOTYPE
msgid "Protocol wrong type for socket"
msgstr "Tipo de protocolo incorrecto para el socket"

# 42 - ENOPROTOOPT
msgid "Protocol not available"
msgstr "Protocolo no disponible"

# 43 - EPROTONOSUPPORT
msgid "Protocol not supported"
msgstr "Protocolo no admitido"

# 44 - ESOCKTNOSUPPORT
msgid "Socket type not supported"
msgstr "Tipo de socket no admitido"

# 45 - EOPNOTSUPP
msgid "Operation not supported"
msgstr "Operación no admitida"

# 46 - EPFNOSUPPORT
msgid "Protocol family not supported"
msgstr "Familia de protocolos no admitida"

# 47 - EAFNOSUPPORT
msgid "Address family not supported by protocol family"
msgstr "Familia de direcciones no admitida por la familia de protocolos"

# 48 - EADDRINUSE
msgid "Address already in use"
msgstr "La dirección ya está en uso"

# 49 - EADDRNOTAVAIL
msgid "Can't assign requested address"
msgstr "No se puede asignar la dirección solicitada"

#
# ipc/network software -- operational errors
#
# 50 - ENETDOWN
msgid "Network is down"
msgstr "La red está caída"

# 51 - ENETUNREACH
msgid "Network is unreachable"
msgstr "La red es inaccesible"

# 52 - ENETRESET
msgid "Network dropped connection on reset"
msgstr "La red cortó la conexión al reiniciarse"

# 53 - ECONNABORTED
msgid "Software caused connection abort"
msgstr "El software provocó el aborto de la conexión"

# 54 - ECONNRESET
msgid "Connection reset by peer"
msgstr "Conexión reiniciada por el otro extremo"

# 55 - ENOBUFS
msgid "No buffer space available"
msgstr "No hay espacio de búfer disponible"

# 56 - EISCONN
msgid "Socket is already connected"
msgstr "El socket ya está conectado"

# 57 - ENOTCONN
msgid "Socket is not connected"
msgstr "El socket no está conectado"

# 58 - ESHUTDOWN
msgid "Can't send after socket shutdown"
msgstr "No se puede enviar después de cerrar el socket"

# 59 - ETOOMANYREFS
msgid "Too many references: can't splice"
msgstr "Demasiadas referencias: no se puede empalmar"

# 60 - ETIMEDOUT
msgid "Operation timed out"
msgstr "Se agotó el tiempo de la operación"

# 61 - ECONNREFUSED
msgid "Connection refused"
msgstr "Conexión rechazada"

# 62 - ELOOP
msgid "Too many levels of symbolic links"
msgstr "Demasiados niveles de enlaces simbólicos"

# 63 - ENAMETOOLONG
msgid "File name too long"
msgstr "Nombre de archivo demasiado largo"

#
# should be rearranged
#
# 64 - EHOSTDOWN
msgid "Host is down"
msgstr "El equipo está caído"

# 65 - EHOSTUNREACH
msgid "No route to host"
msgstr "No hay ruta hasta el equipo"

# 66 - ENOTEMPTY
msgid "Directory not empty"
msgstr "El directorio no está vacío"

#
# quotas & mush
#
# 67 - EPROCLIM
msgid "Too many processes"
msgstr "Demasiados procesos"

# 68 - EUSERS
msgid "Too many users"
msgstr "Demasiados usuarios"

# 69 - EDQUOT
msgid "Disc quota exceeded"
msgstr "Cuota de disco excedida"

#
# Network File System
#
# 70 - ESTALE
msgid "Stale NFS file handle"
msgstr "Identificador de archivo NFS obsoleto"

# 71 - EREMOTE
msgid "Too many levels of remote in path"
msgstr "Demasiados niveles remotos en la ruta"

# 72 - EBADRPC
msgid "RPC struct is bad"
msgstr "La estructura RPC es incorrecta"

# 73 - ERPCMISMATCH
msgid "RPC version wrong"
msgstr "Versión de RPC incorrecta"

# 74 - EPROGUNAVAIL
msgid "RPC prog. not avail"
msgstr "Programa RPC no disponible"

# 75 - EPROGMISMATCH
msgid "Program version wrong"
msgstr "Versión de programa incorrecta"

# 76 - EPROCUNAVAIL
msgid "Bad procedure for program"
msgstr "Procedimiento incorrecto para el programa"

# 77 - ENOLCK
msgid "No locks available"
msgstr "No hay bloqueos disponibles"

# 78 - ENOSYS
msgid "Function not implemented"
msgstr "Función no implementada"

# 79 - EFTYPE
msgid "Inappropriate file type or format"
msgstr "Tipo o formato de archivo inapropiado"

# 80 - EAUTH
msgid "Authentication error"
msgstr "Error de autenticación"

# 81 - ENEEDAUTH
msgid "Need authenticator"
msgstr "Se necesita un autenticador"

# 82 - EIDRM
msgid "Identifier removed"
msgstr "Identificador eliminado"

# 83 - ENOMSG
msgid "No message of desired type"
msgstr "No hay mensajes del tipo deseado"

# 84 - EOVERFLOW
msgid "Value too large to be stored in data type"
msgstr "Valor demasiado grande para almacenarse en el tipo de dato"

# 85 - ECANCELED
msgid "Operation canceled"
msgstr "Operación cancelada"

# 86 - EILSEQ
msgid "Illegal byte sequence"
msgstr "Secuencia de bytes ilegal"

# 87 - ENOATTR
msgid "Attribute not found"
msgstr "Atributo no encontrado"

#
# General
#
# 88 - EDOOFUS
msgid "Programming error"
msgstr "Error de programación"

# 89 - EBADMSG
msgid "Bad message"
msgstr "Mensaje incorrecto"

# 90 - EMULTIHOP
msgid "Multihop attempted"
msgstr "Se intentó un multisalto"

# 91 - ENOLINK
msgid "Link has been severed"
msgstr "El enlace se ha cortado"

# 92 - EPROTO
msgid "Protocol error"
msgstr "Error de protocolo"

# 93 - ENOTCAPABLE
msgid "Capabilities insufficient"
msgstr "Capacidades insuficientes"

# 94 - ECAPMODE
msgid "Not permitted in capability mode"
msgstr "No permitido en modo de capacidades"

# 95 - ENOTRECOVERABLE
msgid "State not recoverable"
msgstr "Estado no recuperable"

# 96 - EOWNERDEAD
msgid "Previous owner died"
msgstr "El propietario anterior murió"

# 97 - EINTEGRITY
msgid "Integrity check failed"
msgstr "Falló la comprobación de integridad"
