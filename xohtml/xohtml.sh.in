VERSION=@LIBXO_VERSION@
LOCAL=@XO_SHAREDIR@
WEB=https://juniper.github.io/libxo/${VERSION}/xohtml
MODE=internal
BASE=
CMD=
DONE=
KEEP=
FILE=

do_help () {
    echo "xohtml: wrap libxo-enabled output in HTML"
    echo "Usage: xohtml [options] [command [arguments]]"
    echo "Valid options are:"
    echo "    -b --base <basepath>        Use a different base location for js/css files"
    echo "    -c | --command <command>    Execute the given shell command"
    echo "    -f | --file <output-file>   Write all output to the given file "
    echo "    -i | --internal             js/css files are written directly into the output"
    echo "    -k | --keep                 Keep the output file (no auto-delete)"
    echo "    -l | --local                js/css files use a local path reference"
    echo "    -m | --minimal              Pass minimal libxo options to the command"
    echo "    -w | --web                  js/css files use a github URL reference"
    exit 1
}

XOPTS=html,xpath,info

while [ -z "$DONE" -a $# -gt 0 ]; do
    case "$1" in
        -b|--base)
            shift;
            MODE=ref;
            BASE="$1";
	    shift;
            ;;
        -c|--command)
            shift;
            CMD="$1";
	    shift;
            ;;
        -f|--file)
            shift;
            FILE="$1";
	    shift;
            ;;
        -i|--internal)
            shift;
            MODE=internal;
            ;;
        -k|--keep)
            shift;
            KEEP=1;
            ;;
        -l|--local)
            shift;
            MODE=ref;
            BASE="${LOCAL}";
            ;;
        -m|--minimal)
            shift;
            XOPTS=html
            ;;
        -w|--web)
            shift;
            MODE=ref;
            BASE="${WEB}";
            ;;

	-*)
	    do_help
	    ;;
	*)
	    DONE=1;
	    ;;
    esac
done

# There are three ways to get our input.  Remaining arguments are a
# command and its arguments, which we keep in "$@" so that arguments
# with spaces or glob characters reach the command intact.  "-c"
# gives a shell command string, which may hold pipes and redirects;
# it is run as given, so it must carry its own --libxo option (see
# xohtml(1)).  Otherwise we wrap stdin.
if [ $# -gt 0 ]; then
    XX="$1"
    shift
    set -- "$XX" "--libxo=$XOPTS" "$@"
    SHOW="$*"
elif [ -n "$CMD" ]; then
    SHOW="$CMD"
elif [ -t 0 ]; then
    do_help
else
    SHOW=cat
fi

# Default output goes to an auto-named file under $TMPDIR, which we then
# open in a browser.  "-f" opts out of both: the caller gets exactly
# the file they asked for and nothing gets opened for them.
OPEN=
if [ -z "$FILE" ]; then
    # This name is predictable, so before writing or removing anything
    # in it, make sure it is a real directory (not a symlink) that we
    # own, and that no one else can write to it.
    DIR="${TMPDIR:-/tmp}"
    DIR="${DIR%/}/${USER:-`id -un`}.xohtml"
    mkdir -m 700 "$DIR" 2>/dev/null
    if [ -L "$DIR" -o ! -d "$DIR" -o ! -O "$DIR" ]; then
        echo "xohtml: $DIR is not a directory owned by you" 1>&2
        exit 1
    fi
    chmod 700 "$DIR" || exit 1

    # Sweep old plain runs.  Files saved with -k/--keep use a
    # different prefix (xohtml-keep.*) and are never touched here.
    rm -f "$DIR"/xohtml.*.html

    TS=`/bin/date "+%y%m%d%H%M.%S"`
    if [ -n "$KEEP" ]; then
        FILE="$DIR/xohtml-keep.${TS}$$.html"
    else
        FILE="$DIR/xohtml.${TS}$$.html"
    fi
    OPEN=1
fi

exec > "$FILE"

esc () {
    printf '%s' "$1" | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g'
}

echo '<html>'
echo '<head>'
echo '<meta http-equiv="content-type" content="text/html; charset=utf-8"/>'
if [ "$MODE" = internal ]; then
    echo '<style>'
    cat "${LOCAL}/xohtml.css"
    echo '</style>'
    echo '<script>'
    cat "${LOCAL}/xohtml.js"
    echo '</script>'
else
    echo '<link rel="stylesheet" href="'"$(esc "$BASE")"'/xohtml.css">'
    echo '<script src="'"$(esc "$BASE")"'/xohtml.js"></script>'
fi
echo '</head>'
echo '<body>'
echo '<div id="xohtml-header">'
echo '<span class="xohtml-cmd">'"$(esc "$SHOW")"'</span>'
echo '<span class="xohtml-time">'"$(/bin/date)"'</span>'
echo '</div>'
echo '<div id="xohtml-content">'

if [ $# -gt 0 ]; then
    "$@"
elif [ -n "$CMD" ]; then
    eval "$CMD"
else
    cat
fi

echo '</div>'
echo '</body>'
echo '</html>'

exec 1>&2

if [ -n "$OPEN" ]; then
    if command -v open >/dev/null 2>&1; then
        open "$FILE"
    elif command -v xdg-open >/dev/null 2>&1; then
        xdg-open "$FILE"
    else
        echo "xohtml: output written to $FILE"
    fi
fi

exit 0
