set top_src=`pwd`
alias Zautoreconf "(cd $top_src ; autoreconf --install)"

set opts=' \
--enable-debug \
--enable-filters \
--enable-warnings \
--enable-printflike \
--prefix ${ROOT_DIR} \
${GETTEXT} \
${LLVMCONFIG} \
'
set opts=`echo $opts`

setenv CONFIGURE_OPTS "$opts"

setenv ROOT_DIR ${HOME}/work/root

set llvm_topdir=/usr/local
set llvm_vers=llvm19
set llvm_path=bin/llvm-config

set make_vers=`make --version`
switch ( "$make_vers" )
    case GNU*:
        set gmake_opts=""
        set zmake=make
        breaksw
    case *:
        set gmake_opts="env MAKE=gmake"
        set zmake=gmake
        breaksw
endsw

switch ( `uname`-`uname -r` )
    case FreeBSD*:
       breaksw
    case Darwin-25*:
       set llvm_topdir=/opt/local/libexec
       set llvm_vers=llvm-21
       breaksw
    case Darwin*:
       set llvm_topdir=/opt/local/libexec
       set llvm_vers=llvm-22
       breaksw
    case Linux*:
       unset llvm_topdir
       breaksw
endsw

if ( $?llvm_topdir ) then
    set llvm_config="${llvm_topdir}/${llvm_vers}/${llvm_path}"
    setenv LLVMCONFIG "--with-llvm-config=${llvm_config}"
else
    setenv LLVMCONFIG ""
endif

set mycflags="-g -O0 -DXO_XPARSE_DEBUG -DLIBXO_DEBUG -DSLAX_DEBUG"

if ( -x /opt/local/bin/msgfmt ) then
    setenv GETTEXT '--with-gettext=/opt/local'
else if ( -x /usr/local/bin/msgfmt ) then
     setenv GETTEXT '--with-gettext=/usr/local'
else
     setenv GETTEXT ''
endif

setenv CONFIGURE_OPTS "$opts"
setenv ADB_PATH $top_src/build/libxo/.libs

alias Zconfigure "(cd $top_src/build; env $gmake_opts ../configure $opts)"
alias Zbuild "(cd $top_src/build; $zmake \!* )"
alias mi "(cd $top_src/build; $zmake && $zmake install); ."
alias mk "make CFLAGS='$mycflags' all install"

alias mm "(cd $top_src/build; $zmake CFLAGS='$mycflags'); ."
alias mmi "(cd $top_src/build; $zmake CFLAGS='$mycflags' && $zmake install); ."

mkdir -p build
cd build
