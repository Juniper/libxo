set top_src=`pwd`
alias Zautoreconf "(cd $top_src ; autoreconf --install)"

setenv ROOT_DIR ${HOME}/work/root

set ZENV=""

set llvm_topdir=/usr/local
set llvm_vers=llvm19
set llvm_path=bin/llvm-config

switch ( `uname`-`uname -r` )
    case FreeBSD*:
       set ZENV="MAKE=gmake "
       breaksw
    case Darwin-25*:
       set llvm_topdir=/opt/local/libexec
       set llvm_vers=llvm-21
       breaksw
    case Darwin*:
       set llvm_topdir=/opt/local/libexec
       set llvm_vers=llvm-19
       breaksw
endsw

set llvm_config="${llvm_topdir}/${llvm_vers}/${llvm_path}"
setenv LLVMCONFIG "--with-llvm-config=${llvm_config}"

set mycflags="-g -O0 -DXO_XPARSE_DEBUG -DLIBXO_DEBUG -DSLAX_DEBUG"

if ( -x /opt/local/bin/msgfmt ) then
    setenv GETTEXT '--with-gettext=/opt/local'
else if ( -x /usr/local/bin/msgfmt ) then
     setenv GETTEXT '--with-gettext=/usr/local'
else
     setenv GETTEXT ''
endif

set opts=' \
--enable-debug \
--enable-filters \
--enable-warnings \
--enable-printflike \
--prefix ${ROOT_DIR} \
${GETTEXT} \
${LLVMCONFIG} \
'
set opts=`echo $opts`

setenv CONFIGURE_OPTS "$opts"
setenv ADB_PATH $top_src/build/libxo/.libs

alias Zconfigure "(cd $top_src/build; env $ZENV ../configure $opts)"
alias Zbuild "(cd $top_src/build; make \!* )"
alias mi "(cd $top_src/build; make && make install); ."
alias mk "make CFLAGS='$mycflags' all install"

mkdir -p build
cd build

if ( -e root ) then
    set ROOT_DIR=`readlink root`
else
    ln -s ${ROOT_DIR} root
endif


alias xx 'cc -I.. -W -Wall -Wstrict-prototypes -Wmissing-prototypes -Wpointer-arith -Werror -Waggregate-return -Wcast-align -Wcast-qual -Wchar-subscripts -Wcomment -Wformat -Wimplicit -Wmissing-declarations -Wnested-externs -Wparentheses -Wreturn-type -Wshadow -Wswitch -Wtrigraphs -Wuninitialized -Wunused -Wwrite-strings -fno-inline-functions-called-once -g -O2 -o xtest -DUNIT_TEST libxo.c'

alias mm "make CFLAGS='$mycflags'"

alias mmi 'mm && mi'
