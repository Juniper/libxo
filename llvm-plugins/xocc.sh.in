#!/bin/sh
#
# This is a cheesy script to invoke $CC with libxo's validate and
# precompile passes.  The validate pass gives meaningful errors
# about libxo format strings, while the precompile pass does
# compile-time parsing and storage of format strings, giving improved
# performance.
#
# Invoke as "make CC=xocc" or "XO_REAL_CC=mycc make CC=xocc"
#

XO_LIBDIR=@XO_LIBDIR@
XO_LOCATION=@XO_LLVMDIR@
XO_SDK_PATH=@SDK_PATH@
XO_LLVM_CLANG=@LLVM_CLANG@

XO_SDK_OPTIONS=${XO_SDK_PATH:+-isysroot ${XO_SDK_PATH}}

XO_VALIDATE_OPTS="\
-fplugin=${XO_LOCATION}/xo_validate.so \
-mllvm -xo-validate-errors-as-warnings \
"

XO_PRECOMPILE_OPTS="\
-fpass-plugin=${XO_LOCATION}/xo_precompile.so \
"

XO_OPTIONS="${XO_VALIDATE_OPTS} ${XO_PRECOMPILE_OPTS}"
XO_CC="@CC@ ${XO_OPTIONS}"

if [ ! -z "${XO_REAL_CC}" ]; then
    # Explictly set implies the user wants our options
    COMPILER="${XO_REAL_CC} ${XO_OPTIONS}"
elif [ ! -z "${XO_LLVM_CLANG}" ]; then
    COMPILER="${XO_LLVM_CLANG} ${XO_OPTIONS} ${XO_SDK_OPTIONS}"
elif [ "@HAVE_GCC@" = "no" ]; then
    # The compiler libxo was compiled with, which isn't gcc, but is not clang?
    COMPILER="${XO_CC}"
else
    # Assumably gcc
    COMPILER="@CC@"
fi

find_stage () {
    local stage=ld
    while [ ! -z "$1" ]; do
	if [ "$1" = "-c" -o "$1" = "-E" -o "$1" = "-S" ]; then
	    stage=cc
	fi
	shift
    done
    echo $stage
}

XO_STAGE=`find_stage "$@"`

if [ "${XO_STAGE}" = "ld" ]; then
    XO_LDFLAGS="-L${XO_LIBDIR} -lxo"
fi

exec ${COMPILER} ${XO_LDFLAGS} "$@"
