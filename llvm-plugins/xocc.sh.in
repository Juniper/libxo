#!/bin/sh
#
# This is a cheesy script to invoke $CC with libxo's validate and
# precompile passes.  The validate pass gives meaningful errors
# about libxo format strings, while the precompile pass does
# compile-time parsing and storage of format strings, giving improved
# performance.
#
# Invoke as "make CC='xocc full'" or "XO_REAL_CC=mycc make CC='xocc full'"
# "xocc validate" and "xocc precompile" are also supported.
#

SELF="$0"

if [ "$1" = "debug" ]; then
    set -x
    XO_DEBUG=1
    shift
fi

XO_LIBDIR=@XO_LIBDIR@
XO_LLVMDIR=@XO_LLVMDIR@
XO_SDK_PATH=@SDK_PATH@
XO_LLVM_CLANG=@LLVM_CLANG@

# Note these are repeated in libxo-config.sh.in
XO_SDK_OPTIONS=${XO_SDK_PATH:+-isysroot ${XO_SDK_PATH}}
XO_VALIDATE_OPTS="-fplugin=${XO_LLVMDIR}/xo_validate.so"
XO_PRECOMPILE_OPTS="-fpass-plugin=${XO_LLVMDIR}/xo_precompile.so"
XO_LDFLAGS="-L${XO_LIBDIR} -lxo"

dbg () {
    if [ ! -z "${XO_DEBUG}" ]; then
	echo "dbg:" "$@"
    fi
}

self_help () {
    echo "xocc: helper script for compiling with libxo(7)"
    echo " "
    echo "  usage:"
    echo "    xocc <verbs> <compiler-options-and-arguments>"
    echo " "

    grep "#\#\#" $SELF | sed -e 's:^.*#\#\# ::' -e 's/: /@/' \
	| awk -F@ '{ printf("        %-16s%s\n", $1, $2); }' | sort

    echo " "
    echo "  verbs can be combine using '+' or removed using '-'"
    echo "     e.g. xocc full+errors+sdk-ldflags ..."
}

parse_verb () {
    local save_verb="$1"
    local verb=`echo "$1" | sed -e 's:+: :g' -e 's:-: -:g'`

    set -- $verb

    need_validate=0
    need_lint=0
    need_errors=0
    need_precompile=0
    need_sdk=1
    need_ldflags=1
    need_echo=0
    need_dry=0

    local msg="see xocc(1) for details"

    while [ ! -z "$1" ]; do
	dbg "processing [$1]"

	case "$1" in
	    help|-help)
		self_help
		exit 0
		;;

	    full|all)
		### full: compile with both plugins
		need_validate=1
		need_lint=1
		need_precompile=1
		;;

	    v|validate)
		### validate: report issues with libxo format strings
		need_validate=1
		;;
	    -v|-validate)
		need_validate=0
		;;
	    l|lint)
		### lint: add flags to validate that report additional issues
		need_lint=1
		;;
	    -l|-lint)
		need_lint=0
		;;
	    e|errors)
		### errors: turn warnings into errors (ala -Werror)
		need_errors=1
		;;
	    -e|-errors)
		need_errors=0
		;;
	    p|precompile)
		### precompile: request build-time compilation of format strings
		need_precompile=1
		;;
	    -p|-precompile)
		need_precompile=0
		;;
	    sdk)
		### sdk: add any compile-time SDK flags needed (MacOS)
		need_sdk=1
		;;
	    -sdk)
		need_sdk=0
		;;
	    ldflags)
		### ldflags: add ld(1) flags as needed for libxo
		need_ldflags=1
		;;
	    -ldflags)
		need_ldflags=0
		;;
	    echo)
		### echo: echo the final command line before executing it
		need_echo=1
		;;
	    -echo)
		need_echo=0
		;;
	    dry)
		### dry: report the command line without executing it
		need_dry=1
		;;
	    -dry)
		need_dry=0
		;;
	    -)
		;; # ignore
	    *.c)
		echo "xocc: missing verb; $msg"
		exit 1
		;;
	    "")
		echo "xocc: unknown verb '$1'; $msg"
		exit 1
		;;
	    *)
		echo "xocc: unknown verb '$1'; $msg"
		exit 1
		;;
	esac
	shift
    done

    jobs=`expr $need_lint + $need_errors + $need_validate + $need_precompile`
    if [ "$jobs" -eq 0 ]; then
	echo "xocc: unknown verb '$save_verb'; $msg"
	exit 1
    fi

    other_than_lint=`expr $need_errors + $need_validate + $need_precompile`
    if [ "$other_than_lint" -eq 0 -a "$need_lint" -eq 1 ]; then
	syntax="-fsyntax-only"
    fi

    if [ "$need_lint" = 1 ]; then
	lint="-mllvm -xo-validate-lint"
	need_validate=1
    fi
    if [ "$need_errors" != 1 ]; then
	errors="-mllvm -xo-validate-errors-as-warnings"
	need_validate=1
    fi
    if [ "$need_validate" = 1 ]; then
	validate="${XO_VALIDATE_OPTS}"
    fi
    if [ "$need_precompile" = 1 ]; then
	precompile="${XO_PRECOMPILE_OPTS}"
    fi
    if [ "$need_sdk" = 1 ]; then
	sdk="${XO_SDK_OPTIONS}"
    fi
    if [ "$need_ldflags" = 1 ]; then
	ldflags="${XO_LDFLAGS}"
    fi

    if [ ! -z "${XO_DEBUG}" ]; then
        dbg "need_validate[$need_validate] validate[$validate]"
 	dbg "need_lint[$need_lint] lint[$lint]"
        dbg "need_errors[$need_errors] errors[$errors]"
        dbg "need_precompile[$need_precompile] precompile[$precompile]"
        dbg "need_sdk[$need_sdk] sdk[$sdk]"
        dbg "need_ldflags[$need_ldflags] ldflags[$ldflags]"
        dbg "need_echo[$need_echo]"
    fi

    XO_OPTIONS="${syntax} ${validate} ${lint} ${errors} ${precompile} ${sdk}"
}

find_stage () {
    local stage=ld
    while [ ! -z "$1" ]; do
	if [ "$1" = "-c" -o "$1" = "-E" -o "$1" = "-S" ]; then
	    stage=cc
	fi
	shift
    done
    echo $stage
}

XO_STAGE=`find_stage "$@"`
dbg XO_STAGE is ${XO_STAGE}

verb="$1"
shift
parse_verb "$verb"

if [ "${XO_STAGE}" != "ld" ]; then
    ldflags=""
fi

# The plugins need to be able to find libxo_format
export LD_LIBRARY_PATH=${XO_LIBDIR}:${LD_LIBRARY_PATH}

if [ ! -z "${XO_REAL_CC}" ]; then
    # Explictly set implies the user wants our options
    COMPILER="${XO_REAL_CC} ${XO_OPTIONS}"
elif [ ! -z "${XO_LLVM_CLANG}" ]; then
    COMPILER="${XO_LLVM_CLANG} ${XO_OPTIONS}"
else
    # The compiler libxo was compiled with, which isn't gcc, but is not clang?
    # Well, they are running "xocc" so they must want our magic....
    COMPILER="@CC@ ${XO_OPTIONS}"
fi

if [ "$need_echo" = 1 ]; then
    set -x
fi

if [ "$need_dry" = 1 ]; then
    echo ${COMPILER} ${ldflags} "$@"
    exit 0
fi

exec ${COMPILER} ${ldflags} "$@"
